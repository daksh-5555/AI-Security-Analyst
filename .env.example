# Copy this file to `.env` and adjust values for local development.
APP_NAME=AI Security Analyst
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./ai_security_analyst.db
# JSON array of filesystem roots under which repository targets may be registered.
REPOSITORY_ALLOWED_ROOTS=["repositories"]
# Discovery resource limits.
REPOSITORY_MAX_FILE_COUNT=10000
REPOSITORY_MAX_DEPTH=50
REPOSITORY_MAX_TOTAL_SIZE_BYTES=536870912
# Technology detection manifest limits.
TECHNOLOGY_MANIFEST_MAX_SIZE_BYTES=1048576
TECHNOLOGY_MAX_MANIFEST_FILES=100
# Attack surface source inspection limits.
ATTACK_SURFACE_SOURCE_MAX_SIZE_BYTES=1048576
ATTACK_SURFACE_MAX_SOURCE_FILES=2000
# Security configuration.
# APP_ENV is required; there is no implicit default. Allowed values:
# development, test, staging, production. Set it explicitly for every process.
# JWT_SECRET is optional in development/test and required in staging/production.
# Generate a unique value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# It must contain at least 32 UTF-8 bytes. Never commit a real secret.
# JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ENV=development
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-security-analyst
JWT_AUDIENCE=ai-security-analyst-api
ACCESS_TOKEN_TTL_SECONDS=600
# Refresh/idle-session and absolute-session lifetimes. Refresh must be >=
# ACCESS_TOKEN_TTL_SECONDS and <= ABSOLUTE_SESSION_TTL_SECONDS.
REFRESH_TOKEN_TTL_SECONDS=1209600
ABSOLUTE_SESSION_TTL_SECONDS=2592000
JWT_CLOCK_SKEW_SECONDS=30
OPAQUE_TOKEN_BYTES=48
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16
# Identity lifecycle email delivery.
# The default backend is `smtp`. `console` must be requested explicitly and is
# permitted only in development/test; it is rejected in staging/production.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@localhost
SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_USERNAME=replace-with-smtp-username
# SMTP_PASSWORD=replace-with-smtp-password
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
# Token lifetimes.
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# Auth abuse controls. The rate limiter is process-local, not distributed.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_TOKEN_REQUEST_COOLDOWN_SECONDS=60
# Failed-login throttling per (account, client address) pair. While throttled, even
# a correct password receives 429. The account-wide threshold only logs an alert;
# it never blocks, so it cannot be used to lock a user out.
AUTH_LOGIN_FAILURE_MAX_ATTEMPTS=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOGIN_ACCOUNT_ALERT_THRESHOLD=50
# The application never trusts X-Forwarded-For. Behind a reverse proxy, start
# Uvicorn with --forwarded-allow-ips=<proxy address> instead.
#
# Bound on audit-table writes caused by unauthenticated requests (process-local).
AUDIT_UNAUTHENTICATED_DENIALS_PER_CLIENT=20
AUDIT_UNAUTHENTICATED_DENIALS_GLOBAL=600
AUDIT_UNAUTHENTICATED_DENIAL_WINDOW_SECONDS=60
# Secret scanning (repository analysis runs). EVIDENCE_FINGERPRINT_KEY is an HMAC
# key (>= 32 bytes) used to fingerprint detected secrets; required in staging and
# production. Without it, development uses an ephemeral per-process key.
# EVIDENCE_FINGERPRINT_KEY=replace-with-at-least-32-random-bytes
SECRET_SCAN_ENABLED=true
SECRET_SCAN_MAX_FILE_SIZE_BYTES=1048576
SECRET_SCAN_MAX_TOTAL_BYTES=67108864
SECRET_SCAN_MAX_FILES=5000
SECRET_SCAN_MAX_MATCHES=1000
# Narrow, justified suppressions (one rule, one repository-relative glob, a reason):
# SECRET_SCAN_ALLOWLIST=[{"rule_id":"secret.jwt","path_glob":"docs/examples/*.md","reason":"Expired sample tokens used in docs"}]
# Project-specific rules (group 1, if present, is the secret):
# SECRET_SCAN_CUSTOM_RULES=[{"rule_id":"custom.acme_key","title":"ACME key","pattern":"\\b(acme_[0-9a-f]{24})\\b","severity":"high"}]
#
# Dependency advisory lookup (OSV). online: queries ADVISORY_OSV_BASE_URL over the
# guarded HTTPS client (only that host is reachable); offline: cache only, uncached
# packages are reported as unchecked; disabled: the tool is skipped (reported).
DEPENDENCY_AUDIT_MODE=online
ADVISORY_OSV_BASE_URL=https://api.osv.dev
# ADVISORY_CACHE_DIR=/var/cache/ai-security-analyst/advisories
ADVISORY_CACHE_TTL_SECONDS=86400
ADVISORY_MAX_PACKAGES=2000
ADVISORY_REQUEST_TIMEOUT_SECONDS=20
DEPENDENCY_MANIFEST_MAX_SIZE_BYTES=10485760
#
# Repository isolation: per_user confines each owner to <allowed root>/<user id>/;
# shared lets all analysts use the whole root (single-team only). Must be set
# explicitly in staging/production.
REPOSITORY_ISOLATION=shared
# Web assessment targets: exact hostnames that may be registered (with an explicit
# authorization statement). Empty = no web targets. Local test networks (e.g. a
# DVWA lab) are allowed in development only.
# WEB_TARGET_ALLOWED_HOSTS=["dvwa.test"]
# WEB_TARGET_ALLOWED_LOCAL_NETWORKS=["127.0.0.0/8"]
#
# Web crawler (web_security assessments; GET only, never submits forms).
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_REQUESTS=150
CRAWLER_MAX_VARIANTS_PER_PATH=3
CRAWLER_RESPECT_ROBOTS=true
# CRAWLER_EXCLUDED_PATHS=["/admin"]
WEB_TARGET_MAX_REQUESTS_PER_SECOND=2
# Runtime XSS/SQLi probes on crawled GET parameters (inert payloads, AND-only SQL
# predicates, never POST). Off by default.
RUNTIME_PROBES_ENABLED=false
RUNTIME_PROBE_MAX_PARAMETERS=10
RUNTIME_PROBE_MAX_REQUESTS=200
#
# Interactive API docs (/docs, /redoc, /openapi.json). Unset: enabled outside
# production, disabled in production.
# API_DOCS_ENABLED=false
#
# Staging and production must set DATABASE_URL, SMTP_HOST, EMAIL_FROM (with a real
# domain), and REPOSITORY_ALLOWED_ROOTS (absolute paths only) explicitly; the
# development defaults above are rejected there.
# Analysis execution and admission. Synchronous runs execute in the request.
# Asynchronous runs (?mode=async) are queued in the database and executed by
# `python -m app.worker`, which also recovers runs whose lease expired
# (ANALYSIS_STALE_AFTER_SECONDS) and retries transient failures (ADR-0011).
#
# Admission control is BEST-EFFORT and PROCESS-LOCAL. Each Uvicorn worker keeps
# its own analysis rate-limit counters, per-user counters, and global semaphore,
# so with N workers the effective limits are approximately N times the values
# below; multiple application instances multiply capacity further. There is no
# deployment-wide enforcement, distributed queue, or distributed lock, and no
# guaranteed FIFO ordering or strict starvation prevention.
#
# Analysis routes are synchronous, so waiting for global capacity blocks a
# worker thread. The queue wait is bounded and is excluded from the execution
# deadline; worst-case request duration is approximately queue wait + execution
# timeout. Do not increase the queue wait casually.
#
# The heartbeat interval and queue wait must be less than the execution timeout.
# The stale threshold must exceed the execution timeout and be at least
# EXECUTION_TIMEOUT + 2 * HEARTBEAT_INTERVAL. Per-user concurrency must not
# exceed global concurrency. The execution timeout cannot be disabled with zero.
# Rate limits are per authenticated user and scope (`analysis.run` and
# `analysis.summary`); zero is not a disable sentinel.
ANALYSIS_EXECUTION_TIMEOUT_SECONDS=300
ANALYSIS_HEARTBEAT_INTERVAL_SECONDS=15
ANALYSIS_STALE_AFTER_SECONDS=420
ANALYSIS_MAX_CONCURRENT_JOBS=2
ANALYSIS_MAX_CONCURRENT_JOBS_PER_USER=1
ANALYSIS_QUEUE_WAIT_SECONDS=2
ANALYSIS_RATE_LIMIT_MAX_REQUESTS=10
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=60
# Off by default: queued runs only progress while a worker is running.
ANALYSIS_ASYNC_ENABLED=false
ANALYSIS_WORKER_MAX_ATTEMPTS=3
ANALYSIS_WORKER_MAX_RUNNING=2
ANALYSIS_WORKER_POLL_INTERVAL_SECONDS=2

# Optional advisory LLM explanations (M9, ADR-0012). Off by default; needs the
# optional extra: pip install ".[ai]". Explanations never change a finding's
# status or severity; inputs are redacted. Put the real key only in your secret
# store or local .env, never in this file.
LLM_EXPLANATIONS_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# LLM_API_KEY=
LLM_EFFORT=medium
LLM_REFUSAL_FALLBACK=true
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=16000
LLM_MAX_PROMPT_CHARS=24000
LLM_MAX_EVIDENCE_ITEMS=10
LLM_MAX_RESPONSE_CHARS=40000
LLM_ASSESSMENT_TOKEN_BUDGET=500000

# Bounded assessment workflows (M10, ADR-0013). Active runtime probes always need a
# recorded human approval inside a workflow, even when RUNTIME_PROBES_ENABLED=true.
WORKFLOW_MAX_STEPS=20
WORKFLOW_MAX_NODE_ATTEMPTS=2
WORKFLOW_MAX_EXPLANATIONS=5

# Curated knowledge retrieval for explanations (M11, ADR-0014). Local only.
RAG_ENABLED=true
RAG_BACKEND=lexical
RAG_MAX_CHUNKS=4
RAG_MAX_CHUNK_CHARS=900
RAG_INCLUDE_STALE=false
# RAG_CORPUS_DIR=/srv/ai-security-analyst/knowledge

# Assessment reports (M12, ADR-0015).
REPORT_MAX_FINDINGS=500
REPORT_MAX_EVIDENCE_PER_FINDING=10
REPORT_MAX_BYTES=5000000

# Workflow orchestration engine (M14, ADR-0017). "builtin" needs nothing extra;
# "langgraph" needs the optional extra: pip install ".[orchestration]".
WORKFLOW_ENGINE=builtin

# Authenticated local lab targets (DVWA) (M15, ADR-0018). Development/lab only;
# forbidden in staging/production. Off by default. See docs/lab/dvwa.md.
WEB_AUTH_LAB_ENABLED=false
WEB_AUTH_LAB_LOGIN_PATH=/login.php
WEB_AUTH_LAB_CSRF_FIELD=user_token
WEB_AUTH_LAB_USERNAME_FIELD=username
WEB_AUTH_LAB_PASSWORD_FIELD=password
